{
  "rulepack": "zhipin",
  "label": "纸品",
  "version": "1.5.2-3",
  "source": "2026-10-13 纸品通用规则：动作完整、堆叠完整、相似画面去重；功能句只配对应画面",
  "product_keywords": ["湿厕纸", "湿巾", "纸巾", "抽纸", "卷纸", "棉柔巾", "洗脸巾", "厨房纸", "手帕纸", "面巾纸"],
  "voice": {},
  "avoid_similar_shots": true,
  "intent_keywords": {"quantity": ["大容量", "容量"],
                      "effect": ["溶解", "可溶", "冲散", "不堵", "清爽", "擦干净", "不滴水", "不容易破", "不易破"]},
  "excluded_claims": ["C-ABSORB-CAPACITY", "C-SPEC", "C-ELASTIC"],
  "sentence_topics": [
    {"id": "pull", "label": "抽取",
     "text_keywords": ["一抽", "抽出", "抽取", "单手抽", "抽一张", "不连张", "连抽", "不连抽"],
     "shot_keywords": ["抽出", "抽取", "抽拉", "拉出"],
     "contradicts": {"不连张": ["连张", "带出两张", "带出好几张", "连着抽出"],
                     "不连抽": ["连张", "带出两张", "带出好几张", "连着抽出"]}},
    {"id": "hang", "label": "挂墙使用",
     "text_keywords": ["挂墙", "挂在墙", "挂起来", "不占", "台面"],
     "shot_keywords": ["挂墙", "挂钩", "挂在", "墙面", "墙上", "悬挂于"]},
    {"id": "count", "label": "包装数量", "match": "count",
     "text_keywords": ["大容量", "容量", "抽装", "片装"]},
    {"id": "tough", "label": "厚实不易破",
     "text_keywords": ["不容易破", "不易破", "不破", "结实", "耐撕", "韧", "厚实", "加厚"],
     "shot_keywords": ["拉伸", "拉扯", "拉开", "撑开", "撑大", "展开", "厚度", "厚实", "折叠", "捏合", "完整巾体"],
     "contradicts": {"不容易破": ["破洞", "撕裂", "破裂", "破损", "扯破", "撕破"],
                     "不易破": ["破洞", "撕裂", "破裂", "破损", "扯破", "撕破"],
                     "不破": ["破洞", "撕裂", "破裂", "破损", "扯破", "撕破"]}},
    {"id": "moisture", "label": "湿度",
     "text_keywords": ["湿度", "不滴水", "滴水", "水分", "湿润", "含水", "多余水分", "不湿哒哒"],
     "shot_keywords": ["湿润", "湿度", "水分", "湿透", "水光", "水滴", "滴水", "滴落", "拧出", "挤出水", "挤压巾体", "沾水"],
     "contradicts": {"不滴水": ["水滴", "滴水", "滴落", "滴下", "挤出水", "拧出水", "挤水", "水流出", "淌水"],
                     "多余水分": ["水滴", "滴水", "滴落", "滴下", "挤出水", "拧出水", "挤水", "水流出", "淌水"],
                     "不湿哒哒": ["水滴", "滴水", "滴落", "滴下", "挤出水", "拧出水", "挤水", "水流出", "淌水"]}},
    {"id": "wipe", "label": "擦拭清洁",
     "text_keywords": ["擦完", "擦拭", "擦干净", "擦不干净", "清爽", "水洗", "洁净"],
     "shot_keywords": ["擦拭", "擦手", "污渍", "清洁"]},
    {"id": "flush", "label": "冲马桶可溶解",
     "text_keywords": ["马桶", "冲走", "冲掉", "可冲", "溶解", "可溶", "不堵"],
     "shot_keywords": ["马桶", "冲水", "冲散", "可冲散", "溶解", "下水", "散开", "散成", "散落", "分散", "碎片", "碎絮", "碎裂"],
     "contradicts": {"不堵": ["堵住", "堵塞", "积水不下"]}},
    {"id": "label", "label": "包装标称", "match": "same_words",
     "text_keywords": ["EDI", "纯水", "配方", "无酒精", "酒精", "无异味", "异味", "宝宝", "婴儿", "孕妇", "敏感肌"]}
  ],
  "analysis_prompt_rules": [
    "产品被挂到挂钩、毛巾杆或墙面上时，description 和 action_segments 要写明“挂到挂钩上/挂在墙上”，并给出挂上去的那一段时间。",
    "抽取动作要写清：是单手还是双手、一次抽出几张、抽出后盒口是否留出下一张的头；看得见就写进 result。",
    "巾体过水或在水龙头下冲淋时，写清冲淋后巾体是“仍然完整”还是“散开、碎裂”；只有画面里真的看到散开、碎裂才能写冲散或溶解。",
    "巾体泡在盆里搅动后再提起时，逐帧看它的形状：分成两块以上、边缘变成棉絮状、或盆底和排水口散落半透明碎片，就是“遇水散开成碎片”，要写进 result 并给出看到碎片的那段时间；整张形状没变才写“仍然完整”。",
    "只拍排水口的镜头，写清水是否顺畅流走、排水口有没有残留碎片或堵住。",
    "擦拭演示要写清擦的是手背、手掌、桌面还是其他表面，擦之前有没有可见污渍，擦完污渍是否消失、巾体上是否沾上污渍。",
    "拉伸、撑开、对折、揉搓巾体时，写明具体动作，以及巾体是否保持完整、有没有破洞或撕裂。"
  ],
  "match_prompt_rules": [
    "画面动作要连贯完整：手拿产品展示的镜头，要从手拿产品入画一直用到展示动作定住，不要截在中途。",
    "产品堆叠的镜头，要从产品入画一直用到堆成一堆、整堆产品完整展示出来。",
    "画面相似的展示镜头（同机位、同构图、同动作）整条视频里尽量只用一次，换不同机位或不同动作的镜头，避免同质化。"
  ],
  "scenes": [
    {
      "id": "stack_product",
      "label": "产品堆叠",
      "kind": "full_window",
      "text_keywords": [],
      "shot_keywords": ["堆叠", "堆放", "叠放", "码放", "摞", "投入", "投放", "落入", "倒入"],
      "shot_fields": ["action"],
      "action_phases": ["perform", "prep"],
      "phases": [
        {"name": "action", "label": "堆叠", "describe": "产品从进入画面开始，到堆叠完成、整堆产品完整展示出来为止"}
      ],
      "speed": {"range": [1.0, 1.5]},
      "hold_after_s": 0.5,
      "settled_fallback": true,
      "requirement": "从产品入画到堆成一堆完整展示完"
    },
    {
      "id": "show_product",
      "label": "手拿产品展示",
      "kind": "full_window",
      "text_keywords": [],
      "shot_keywords": ["举起", "拿起", "拿取", "捏起", "捏取", "托举", "捧持", "抱持", "手持", "拿出", "取出", "递", "入画", "展示"],
      "shot_fields": ["action"],
      "action_phases": ["perform", "prep"],
      "phases": [
        {"name": "action", "label": "拿产品展示", "describe": "手拿着产品进入画面（或开始拿起产品）到展示动作定住、产品停稳为止"}
      ],
      "speed": {"range": [1.0, 1.5]},
      "hold_after_s": 0.3,
      "settled_fallback": true,
      "requirement": "从手拿产品入画到展示动作定住"
    },
    {
      "id": "usage_action",
      "label": "完整动作",
      "kind": "full_window",
      "text_keywords": [],
      "shot_keywords": ["抽出", "抽取", "拉出", "拉伸", "展开", "撕开", "揭开"],
      "shot_fields": ["action"],
      "action_phases": ["perform", "prep"],
      "phases": [
        {"name": "action", "label": "动作", "describe": "动作从开始到做完为止（例如纸巾从开始抽到整张抽出、从开始拉到拉开定住）"}
      ],
      "speed": {"range": [1.0, 1.5]},
      "settled_fallback": true,
      "requirement": "动作从开始到做完，不截在中途"
    }
  ]

{
  "rulepack": "weipin",
  "label": "卫品",
  "version": "1.5.3-1",
  "source": "卫品AI智能混剪通行指令",
  "product_keywords": ["卫生巾", "护垫", "安睡裤", "裤型", "日用", "夜用", "姨妈巾", "经期裤", "萌睡裤", "萌动裤"],
  "voice": {
    "tempo": 1.2,
    "max_gap_frames": 1
  },
  "match_prompt_rules": [
    "每个画面里没有静止不动的空镜；手完成动作后要马上离开画面。",
    "同一个镜头只表达一次动作，不要把同一个动作在相邻几句里反复用。",
    "口播提到面层、表层或接触面时，必须选能看清面层的镜头。",
    "口播讲背标、配料或产品信息时，用一个能看清背标的镜头盖住整句，不要拼接。",
    "吸水实验要选能看到倒水、吸收、纸巾擦拭全过程的同一条素材。",
    "口播只要讲到吸水、吸收快、不反渗、不回流这类卖点，就算没说「实验」两个字，也配吸水实验素材。",
    "「量大」「量多」「一整晚」说的是经血量大也兜得住，配倒液体后液体被吸住、锁在中央不往外扩的画面，不是配很多盒产品。",
    "讲透气、透气孔、不闷时，配把巾体举到灯光前、光从巾体透过来的镜头，或能看清面层孔洞、网面的特写。",
    "举到灯前透光、看内部结构，演的是轻薄/透气，不是吸水实验；描述里出现「吸水层」也不能当倒液、吸收证据。瞬吸、吸得快必须配看见倒液体、液体被吸入的画面。",
    "拆包=从外包装把产品拿出来：口播讲独立包装/单独包装/未拆封/即开即用/新鲜取出，或说撕开、拆开、取出、拿出时，必须选看得见撕口/开封/抽出产品的动作镜头，并带产品本体；袋面静物、荧光测试、透光都不是拆包。",
    "拆包优先同一条素材：撕开/取出后接着展开看面层；独立包装卖点禁止只用密封袋面或外包装静态特写。",
    "产品展示不要连着几句都拍外包装袋面：上一句已是未拆封袋面/外包装展示，这一句若又选中袋面或密封包装特写，优先换成拆包（撕开/取出产品）动作镜；文案讲包装时同理。荧光、面层、吸水等专属卖点句，以及品牌/促销/报数量句，不要为此硬拐拆包。",
    "口播讲腰围、弹力腰、不勒肚子时，优先选撑开/拉伸裤腰或指腰头橡筋的镜头，不要用普通包装展示。",
    "口播讲防侧漏时，优先选立体护边、侧边特写或侧翼结构镜头，不要把只拉伸腰围的镜头当防侧漏。",
    "口播讲超薄、轻薄时，优先选能看出厚度薄（对光透光、手指捏薄对比）的镜头；只拉伸腰围不能证明超薄。",
    "口播报「每包×片」「4片」时，优先选扇形展开、一叠可数清片数的镜头，不要只用封口包装正面。"
  ],
  "analysis_prompt_rules": [
    {"text": "巾体被举到灯光、窗户或手电前，光从背面透过来时，description 要写明「对光展示，光线透过巾体」，不要只写成反光。",
     "recheck": ["灯光", "反光", "光源", "逆光", "透光", "对光", "手电"]},
    {"text": "倒液体的实验要写清液体倒在巾体哪个位置、是否被锁在中央、有没有向四周或两侧扩散，以及最后表面看起来干不干。",
     "recheck": ["倒", "倾倒", "蓝水", "蓝色液体", "液体"]},
    {"text": "手掌或手指在巾体接触面反复抚摸、按压展示质感时，description 和 evidence_tags 必须写「抚摸面层」或「面层特写」；只写「展示」「翻转」不够。能看清孔洞、网面、压纹或凸点时写明是哪一种。",
     "recheck": ["抚摸", "按压", "翻动", "质感", "表面"]},
    {"text": "用手撑开、拉伸裤腰/腰围，或手指明确指向腰头橡筋褶皱时，description 和 evidence_tags 必须写「弹力腰围」或「腰腹展示」；不要只写「拉伸」「展示」。",
     "recheck": ["拉伸", "腰", "橡筋", "裤腰", "撑开", "腰头"]},
    {"text": "能看清立体护边、侧翼或侧边防漏结构时，description 和 evidence_tags 必须写「立体护边」或「防侧漏结构」。只拉伸腰围、没有护边特写时，不要写成防侧漏。",
     "recheck": ["护边", "侧边", "侧翼", "立体", "防漏"]},
    {"text": "能看出巾体很薄时必须写明依据：对光透光、或手指捏住对比厚度；evidence_tags 写「超薄」或「轻薄透气」。仅拉伸腰围/魔术贴粘扣，不能当超薄或透气证据。",
     "recheck": ["薄", "透光", "对光", "捏", "魔术贴", "粘扣"]},
    {"text": "把多片巾体扇形展开、或从包装取出一叠并展开到能数清片数时，description 写「多片展开」并尽量写清可见片数（如「展开约4片」）；evidence_tags 加「多片展开」。看不清片数就写「一叠展开」，不要猜数字。",
     "recheck": ["扇形", "一叠", "多片", "展开", "取出巾体"]},
    {"text": "检测笔、紫光灯或带屏幕的荧光检测设备贴着/照着巾体，并出现可读数字或读数时，description 和 evidence_tags 必须写「荧光测试」和「读数」；普通计时器红字、仅电子设备都不能当荧光测试。",
     "recheck": ["检测笔", "紫光", "荧光", "读数", "检测设备", "LED", "屏幕"]},
    {"text": "用纸巾、手指按压已吸过液体的巾体时，写清纸巾或手指上有没有沾到液体。", "recheck": ["按压", "擦拭", "纸巾"]},
    {"text": "镜头里有撕开、拆开包装或从包装里取出产品的动作时，description 要写明「撕开」「取出」等动作词；只是展示未拆封的包装袋面时写「未拆封展示」。", "recheck": ["撕", "拆", "取出", "包装"]}
  ],
